# Select the Appwrite-backed runtime.
LANIS_MODE=appwrite

# Appwrite project connection. Appwrite Functions normally receive a dynamic
# key in x-appwrite-key; LANIS_APPWRITE_API_KEY is only a local/external fallback.
LANIS_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
LANIS_APPWRITE_PROJECT_ID=698337a60017b46df380
LANIS_APPWRITE_API_KEY=

# Resource IDs declared in appwrite.config.json.
LANIS_APPWRITE_DATABASE_ID=lanis
LANIS_APPWRITE_REFRESH_TOKENS_TABLE_ID=refresh_tokens
LANIS_APPWRITE_RESPONSE_CACHE_TABLE_ID=response_cache
LANIS_APPWRITE_USER_METRICS_TABLE_ID=user_metrics
LANIS_APPWRITE_FILE_METADATA_TABLE_ID=file_metadata
LANIS_APPWRITE_DSB_SNAPSHOTS_TABLE_ID=dsb_snapshots
LANIS_APPWRITE_STORAGE_BUCKET_ID=lanis-files
LANIS_APPWRITE_TASK_FUNCTION_ID=lanis-worker
LANIS_APPWRITE_DSB_FUNCTION_ID=lanis-dsb-snapshot

# Generate a high-entropy value of at least 32 characters. Never commit it.
LANIS_APPWRITE_ENCRYPTION_KEY=<REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS>

# API configuration.
JWT_SECRET=<REPLACE_WITH_A_LONG_RANDOM_SECRET>
PUBLIC_BASE_URL=https://<YOUR_API_FUNCTION_DOMAIN>

# Only required by the scheduled DSB Function.
DSB_USERNAME=
DSB_PASSWORD=
DSB_SCHOOL_ID=

# Optional semantic-search provider.
AI_API_URL=
AI_API_KEY=
AI_EMBEDDING_MODEL=google/gemini-embedding-2
