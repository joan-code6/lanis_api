# Keep existing application/authentication configuration in your private .env.
# Public ingestion token, never a personal phx_ administration token.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://t.lanis.arg-server.de
# Logs and tracing activate automatically when the ingestion token is configured.
# Set to 0 to disable operational OTLP export without disabling product events.
POSTHOG_OBSERVABILITY=1
LANIS_ENVIRONMENT=production
# Optional deployed Git SHA for grouping operational signals by release.
LANIS_RELEASE=
